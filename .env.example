# Copiez ce fichier en ".env" (sans .example) et remplissez vos vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être envoyé sur GitHub (voir .gitignore).
#
# Pour tester gratuitement sans envoyer de vrais emails, créez un compte sur
# https://mailtrap.io puis copiez les identifiants "SMTP Settings" de votre inbox.

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=votre_identifiant_mailtrap
SMTP_PASS=votre_mot_de_passe_mailtrap
SMTP_FROM=noreply@example.com
